    {
      "parameters": {
        "jsCode": "// =========================================\n// Professional Meeting Scheduler Parser\n// Processes ONLY the latest submitted row\n// =========================================\n\nconst TIMEZONE = \"Asia/Kolkata\";\n\n// Always take the latest row\nconst item = $input.last().json;\n\n// -----------------------------\n// Extract Fields\n// -----------------------------\nconst meetingTitle = item[\"Meeting Title\"] || \"Meeting\";\nconst meetingPurpose = item[\"Meeting Purpose\"] || \"\";\nconst fullName = item[\"Full Name\"] || \"\";\nconst email = item[\"Email ID\"] || \"\";\n\nconst preferredDate = item[\"Preferred Date\"];\nconst preferredTime = item[\"Preferred Time\"];\nconst durationText = item[\"Duration\"] || \"30 Minutes\";\n\n// -----------------------------\n// Parse Duration\n// -----------------------------\nconst durationMatch = durationText.match(/\\d+/);\nconst durationMinutes = durationMatch\n    ? parseInt(durationMatch[0], 10)\n    : 30;\n\n// -----------------------------\n// Parse Date\n// -----------------------------\nconst [month, day, year] = preferredDate\n    .split(\"/\")\n    .map(Number);\n\n// -----------------------------\n// Parse Time\n// -----------------------------\nconst timeMatch = preferredTime.match(\n    /(\\d+):(\\d+):(\\d+)\\s*(AM|PM)/i\n);\n\nif (!timeMatch) {\n    throw new Error(`Invalid Preferred Time: ${preferredTime}`);\n}\n\nlet hour = parseInt(timeMatch[1], 10);\nconst minute = parseInt(timeMatch[2], 10);\nconst second = parseInt(timeMatch[3], 10);\nconst meridian = timeMatch[4].toUpperCase();\n\nif (meridian === \"PM\" && hour !== 12) hour += 12;\nif (meridian === \"AM\" && hour === 12) hour = 0;\n\n// -----------------------------\n// Create Start & End Date\n// -----------------------------\nconst startDate = new Date(\n    year,\n    month - 1,\n    day,\n    hour,\n    minute,\n    second\n);\n\nconst endDate = new Date(startDate);\nendDate.setMinutes(endDate.getMinutes() + durationMinutes);\n\n// -----------------------------\n// ISO Format\n// -----------------------------\nconst startISO = startDate.toISOString();\nconst endISO = endDate.toISOString();\n\n// -----------------------------\n// Human Readable\n// -----------------------------\nconst readableStart = startDate.toLocaleString(\"en-IN\", {\n    timeZone: TIMEZONE,\n    weekday: \"long\",\n    day: \"numeric\",\n    month: \"long\",\n    year: \"numeric\",\n    hour: \"numeric\",\n    minute: \"2-digit\",\n    hour12: true,\n});\n\nconst readableEnd = endDate.toLocaleString(\"en-IN\", {\n    timeZone: TIMEZONE,\n    hour: \"numeric\",\n    minute: \"2-digit\",\n    hour12: true,\n});\n\n// -----------------------------\n// Return\n// -----------------------------\nreturn [\n{\n    json: {\n\n        meetingTitle,\n        meetingPurpose,\n\n        fullName,\n        email,\n\n        timezone: TIMEZONE,\n\n        durationMinutes,\n\n        preferredDate,\n        preferredTime,\n\n        startTime: readableStart,\n        endTime: readableEnd,\n\n        startISO,\n        endISO,\n\n        calendarCheck: {\n            timeMin: startISO,\n            timeMax: endISO,\n        },\n\n        calendarEvent: {\n            summary: meetingTitle,\n            description: meetingPurpose,\n\n            start: {\n                dateTime: startISO,\n                timeZone: TIMEZONE,\n            },\n\n            end: {\n                dateTime: endISO,\n                timeZone: TIMEZONE,\n            },\n\n            attendees: [\n                {\n                    email,\n                    displayName: fullName,\n                }\n            ]\n        }\n\n    }\n}\n];"
      },
