      "id": "15c72f01-b9bb-4116-8c30-10a0f2d54bcd",
      "name": "01 - Patient Health Assessment Form"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  // Generate patient case ID\n  const caseId = `MED-${Date.now()}`;\n\n  // Normalize emergency symptoms\n  const emergencySymptoms = String(data[\"Emergency Symptoms\"] || \"\")\n    .split(\",\")\n    .map(symptom => symptom.trim())\n    .filter(Boolean);\n\n  const emergencyKeywords = [\n    \"severe chest pain\",\n    \"difficulty breathing\",\n    \"unconsciousness\",\n    \"severe bleeding\",\n    \"stroke symptoms\",\n    \"severe allergic reaction\",\n    \"seizure\"\n  ];\n\n  const hasEmergencyRedFlag = emergencySymptoms.some(symptom =>\n    emergencyKeywords.some(keyword =>\n      symptom.toLowerCase().includes(keyword)\n    )\n  );\n\n  const painLevel = Number(data[\"Pain Level\"] || 0);\n\n  return {\n    json: {\n      case_id: caseId,\n      submitted_at: data.submittedAt || new Date().toISOString(),\n\n      patient_name: data[\"Patient Name\"] || \"\",\n      age: Number(data.Age || 0),\n      gender: data.Gender || \"\",\n      mobile_number: data[\"Mobile Number\"] || \"\",\n      email: data.Email || \"\",\n\n      main_symptoms: data[\"Main Symptoms\"] || \"\",\n      symptom_duration: data[\"Symptom Duration\"] || \"\",\n      pain_level: painLevel,\n\n      existing_medical_conditions:\n        data[\"Existing Medical Conditions\"] || \"None reported\",\n\n      current_medications:\n        data[\"Current Medications\"] || \"None reported\",\n\n      allergies: data.Allergies || \"None reported\",\n\n      emergency_symptoms: emergencySymptoms,\n      additional_information: data[\"Additional Information\"] || \"\",\n\n      consent_given: Boolean(\n        data[\"Consent to Process Data\"]?.length\n      ),\n\n      has_emergency_red_flag: hasEmergencyRedFlag,\n\n      processing_status: \"Ready for AI Assessment\"\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        0
      ],
      "id": "ecd0547c-9448-4ead-88c2-9639183aa195",
      "name": "\t02 - Validate & Normalize Patient Data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "5733ae35-1e33-43aa-a565-4f53f1f79f56",
