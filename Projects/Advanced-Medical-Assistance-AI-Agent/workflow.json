        "jsonSchemaExample": "\n{\n  \"type\": \"object\",\n  \"properties\": {\n    \"patient_name\": {\"type\": \"string\"},\n    \"case_id\": {\"type\": \"string\"},\n    \"symptom_summary\": {\"type\": \"string\"},\n    \"urgency_level\": {\n      \"type\": \"string\",\n      \"enum\": [\"Emergency\", \"Urgent\", \"Standard\"]\n    },\n    \"emergency_detected\": {\"type\": \"boolean\"},\n    \"emergency_reason\": {\"type\": \"string\"},\n    \"recommended_action\": {\"type\": \"string\"},\n    \"doctor_review_required\": {\"type\": \"boolean\"},\n    \"assessment_status\": {\"type\": \"string\"}\n  },\n  \"required\": [\n    \"patient_name\",\n    \"case_id\",\n    \"symptom_summary\",\n    \"urgency_level\",\n    \"emergency_detected\",\n    \"emergency_reason\",\n    \"recommended_action\",\n    \"doctor_review_required\",\n    \"assessment_status\"\n  ]\n}\n"
