    {
      "parameters": {
        "jsCode": "\nconst data = $input.first().json;\n\nconst date = String(data.normalized_date ?? '');\n\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date)) {\n  throw new Error('Invalid schedule date');\n}\n\nreturn [{\n  json: {\n    ...data,\n    normalized_date: date\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        -144
      ],
      "id": "f8be1253-63b5-48c1-bc05-6c2205e392d3",
      "name": "Normalize Schedule Date"
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\nconst request = $('Compare Schedule Change').first().json;\n\nfunction toMinutes(value) {\n  const match = String(value ?? '').trim().match(\n    /^(\\d{1,2})(?::(\\d{2}))?\\s*(AM|PM)?$/i\n  );\n\n  if (!match) return null;\n\n  let h = Number(match[1]);\n  const m = Number(match[2] ?? 0);\n  const period = (match[3] ?? '').toUpperCase();\n\n  if (m > 59 || h > 23) return null;\n\n  if (period) {\n    if (h < 1 || h > 12) return null;\n    if (period === 'PM' && h !== 12) h += 12;\n    if (period === 'AM' && h === 12) h = 0;\n  }\n\n  return h * 60 + m;\n}\n\nconst requestedStart = toMinutes(request.new_time);\nconst requestedEnd = toMinutes(request.new_end_time);\n\nif (requestedStart === null || requestedEnd === null) {\n  throw new Error('Invalid requested schedule time');\n}\n\nconst conflicts = [];\n\nfor (const item of rows) {\n  const row = item.json;\n\n  // Ignore the batch being changed\n  if (\n    String(row.batch_name ?? '').trim().toLowerCase() ===\n    String(request.requested_batch ?? '').trim().toLowerCase()\n  ) {\n    continue;\n  }\n\n  const rowDate = String(row.date ?? '').slice(0, 10);\n\n  // Only compare schedules on the same date\n  if (rowDate !== request.normalized_date) continue;\n\n  const existingStart = toMinutes(row.start_time);\n  const existingEnd = toMinutes(row.end_time);\n\n  if (existingStart === null || existingEnd === null) continue;\n\n  // Check whether the time intervals overlap\n  const overlap =\n    requestedStart < existingEnd &&\n    requestedEnd > existingStart;\n\n  const sameRoom =\n    String(row.room ?? '').trim().toLowerCase() ===\n    String(request.room ?? '').trim().toLowerCase();\n\n  const sameTrainer =\n    String(row.trainer ?? '').trim().toLowerCase() ===\n    String(request.trainer ?? '').trim().toLowerCase();\n\n  if (overlap && (sameRoom || sameTrainer)) {\n    conflicts.push({\n      batch_name: row.batch_name,\n      start_time: row.start_time,\n      end_time: row.end_time,\n      trainer: row.trainer,\n      room: row.room\n    });\n  }\n}\n\nreturn [{\n  json: {\n    ...request,\n    conflict_found: conflicts.length > 0,\n    conflicts,\n    conflict_count: conflicts.length\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
