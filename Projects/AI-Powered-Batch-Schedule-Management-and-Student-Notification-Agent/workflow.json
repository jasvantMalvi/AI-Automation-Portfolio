    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\n\nconst raw = input.output ?? input.text ?? input.response ?? input;\n\nlet data;\n\nif (typeof raw === 'string') {\n  const cleaned = raw\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  data = JSON.parse(cleaned);\n} else {\n  data = raw;\n}\n\nreturn [{\n  json: {\n    intent: data.intent ?? null,\n    batch_name: data.batch_name?.trim() ?? null,\n    new_time: data.new_time ?? null,\n    date: data.date ?? null,\n    reason: data.reason ?? null\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -48
      ],
      "id": "e0c4d1f4-378b-4a87-903d-196cf07d52cf",
      "name": "Parse Schedule Data"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_GOOGLE_SHEET_ID",
          "mode": "list",
          "cachedResultName": "Your Batch Schedule Spreadsheet"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        2016,
        -144
      ],
      "id": "ab07fc6a-8790-4b3c-85de-da0e54d6b275",
      "name": "Get Existing Batch Schedule"
    },
    {
      "parameters": {
        "jsCode": "\nconst request = $('Parse Schedule Data').first().json;\nconst existing = $input.first().json;\n\nfunction toMinutes(value) {\n  const match = String(value ?? '').trim().match(\n    /^(\\d{1,2})(?::(\\d{2}))?\\s*(AM|PM)?$/i\n  );\n\n  if (!match) throw new Error('Invalid time: ' + value);\n\n  let h = Number(match[1]);\n  const m = Number(match[2] ?? 0);\n  const period = (match[3] ?? '').toUpperCase();\n\n  if (m > 59 || h > 23 || h < 0) {\n    throw new Error('Invalid time: ' + value);\n  }\n\n  if (period) {\n    if (h < 1 || h > 12) throw new Error('Invalid 12-hour time');\n    if (period === 'PM' && h !== 12) h += 12;\n    if (period === 'AM' && h === 12) h = 0;\n  }\n\n  return h * 60 + m;\n}\n\nfunction formatTime(minutes) {\n  const h = Math.floor(minutes / 60) % 24;\n  const m = minutes % 60;\n\n  return String(h).padStart(2, '0') + ':' +\n         String(m).padStart(2, '0');\n}\n\nconst currentStart = toMinutes(existing.start_time);\nconst currentEnd = toMinutes(existing.end_time);\nconst newStart = toMinutes(request.new_time);\n\nconst duration = currentEnd - currentStart;\n\nif (duration <= 0) {\n  throw new Error('Invalid existing batch duration');\n}\n\nif (newStart + duration > 1440) {\n  throw new Error('New schedule exceeds the day');\n}\n\nconst newEnd = newStart + duration;\n\nreturn [{\n  json: {\n    ...existing,\n    requested_batch: request.batch_name,\n    current_time: formatTime(currentStart),\n    old_time: existing.start_time,\n    new_time: formatTime(newStart),\n    new_end_time: formatTime(newEnd),\n    normalized_date: request.date,\n    reason: request.reason,\n    actual_change: newStart !== currentStart\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        -144
      ],
      "id": "f4cc6546-7a92-41e0-92c2-6f0f3114d934",
