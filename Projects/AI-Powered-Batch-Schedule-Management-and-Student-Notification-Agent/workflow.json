      "id": "15a654e4-9e65-49a0-aa73-df6c0e7de9d9",
      "name": "Conflict Found"
    },
    {
      "parameters": {
        "jsCode": "const schedule = $('Compare Schedule Change').first().json;\n\n// Read student names from your Google Sheet's \"students\" column\nconst studentNames = String(schedule.students || '')\n  .split(',')\n  .map(name => name.trim())\n  .filter(name => name !== '');\n\nif (studentNames.length === 0) {\n  return [{\n    json: {\n      no_students_found: true,\n      message: 'No students found for this batch.'\n    }\n  }];\n}\n\nreturn studentNames.map(studentName => {\n  const message =\n`Hello ${studentName},\n\nYour batch schedule has been updated.\n\nBatch: ${schedule.batch_name}\nDate: ${schedule.normalized_date}\nPrevious Time: ${schedule.old_time}\nNew Time: ${schedule.new_time}\n\nReason: ${schedule.reason || 'Schedule adjustment'}\n\nPlease follow the updated schedule.\n\nRegards,\nTraining Administration`;\n\n  return {\n    json: {\n      student_name: studentName,\n      notification_message: message\n    }\n  };\n});"
      },
