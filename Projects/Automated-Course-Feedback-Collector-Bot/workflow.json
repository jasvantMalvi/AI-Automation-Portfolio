    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst hasRating =\n  data.rating !== null &&\n  data.rating !== undefined &&\n  data.rating !== \"\";\n\nconst hasSentiment =\n  typeof data.sentiment === \"string\" &&\n  data.sentiment.trim() !== \"\";\n\nconst hasTopics =\n  Array.isArray(data.topics) &&\n  data.topics.length > 0;\n\nconst hasSuggestions =\n  Array.isArray(data.suggestions);\n\nconst hasPriority =\n  typeof data.priority === \"string\" &&\n  data.priority.trim() !== \"\";\n\nconst isComplete =\n  hasRating &&\n  hasSentiment &&\n  hasTopics &&\n  hasSuggestions &&\n  hasPriority;\n\nreturn [\n  {\n    json: {\n      ...data,\n\n      has_rating: hasRating,\n      has_sentiment: hasSentiment,\n      has_topics: hasTopics,\n      has_suggestions: hasSuggestions,\n      has_priority: hasPriority,\n\n      feedback_complete: isComplete,\n\n      validation_status: isComplete\n        ? \"Complete\"\n        : \"Incomplete\"\n    }\n  }\n];"
      },
