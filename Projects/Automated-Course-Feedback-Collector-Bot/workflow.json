    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this student course feedback:\n\nStudent Name:\n{{ $json.student_name }}\n\nFeedback:\n{{ $json.feedback_text }}\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"student_name\": \"\",\n  \"rating\": null,\n  \"sentiment\": \"\",\n  \"topics\": [],\n  \"suggestions\": [],\n  \"priority\": \"\"\n}\n\nRules:\n- Rating must be a number from 1 to 5, or null if not mentioned.\n- Sentiment must be Positive, Neutral, or Negative.\n- Topics must contain the main topics discussed.\n- Suggestions must contain improvement suggestions. If none, return [].\n- Priority must be Low, Medium, or High.\n- Do not invent information.\n- Return JSON only. No markdown and no explanation.",
        "options": {
          "systemMessage": "You are an AI Course Feedback Analysis Agent.\n\nYour job is to analyze student course feedback and extract structured information.\n\nAnalyze the provided feedback and identify:\n\n1. Rating — numerical rating from 1 to 5 if mentioned.\n2. Sentiment — Positive, Neutral, or Negative.\n3. Topics — main topics discussed in the feedback.\n4. Suggestions — improvements suggested by the student.\n5. Priority — Low, Medium, or High.\n\nRules:\n- Do not invent information.\n- If rating is not mentioned, return null.\n- If suggestions are not mentioned, return an empty array.\n- Keep topics concise.\n- Priority should be High when the feedback contains a very low rating, serious complaint, urgent issue, or strong negative experience.\n- Priority should be Medium for moderate concerns or improvement requests.\n- Priority should be Low for positive feedback or minor/non-urgent comments.\n- Return ONLY valid JSON."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2240,
        160
      ],
      "id": "ce916e73-b7d8-40d9-92ed-1b60536ae3c9",
      "name": "AI Feedback Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
