      "parameters": {
        "jsCode": "const data = $json;\n\nconst userContext = $('User Context Normalizer').item.json;\n\nconst studentName =\n  data.student_name ||\n  userContext.student_name ||\n  userContext.user_name ||\n  \"\";\n\nconst feedbackText =\n  data.feedback_text ||\n  data.text ||\n  \"\";\n\nconst cleanedFeedback = String(feedbackText)\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nreturn [\n  {\n    json: {\n      student_name: studentName,\n      feedback_text: cleanedFeedback,\n\n      user_id:\n        data.user_id ||\n        userContext.user_id ||\n        null,\n\n      username:\n        data.username ||\n        userContext.username ||\n        null,\n\n      chat_id:\n        data.chat_id ||\n        userContext.chat_id ||\n        null,\n\n      message_id:\n        data.message_id ||\n        userContext.message_id ||\n        null,\n\n      message_date:\n        data.message_date ||\n        userContext.message_date ||\n        null,\n\n      input_type: \"text\",\n\n      course_name: userContext.course_name || \"\",\nrating: userContext.rating ?? null,\nstudent_id: userContext.student_id || null,\n\n      received_at:\n        data.received_at ||\n        userContext.received_at ||\n        new Date().toISOString()\n    }\n  }\n];"
