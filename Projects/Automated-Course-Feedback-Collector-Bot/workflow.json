    {
      "parameters": {
        "jsCode": "const data = $json;\nconst userContext = $('User Context Normalizer').item.json;\n\n// ElevenLabs transcription can appear in different fields.\n// Try the common transcription fields.\nconst transcript =\n  data.text ||\n  data.transcript ||\n  data.transcription ||\n  data.output_text ||\n  \"\";\n\nconst studentName =\n  userContext.student_name ||\n  userContext.user_name ||\n  \"\";\n\nreturn [\n  {\n    json: {\n      student_name: studentName,\n      feedback_text: String(transcript).replace(/\\s+/g, \" \").trim(),\n\n      user_id: userContext.user_id || null,\n      username: userContext.username || null,\n      chat_id: userContext.chat_id || null,\n\n      message_id: userContext.message_id || null,\n      message_date: userContext.message_date || null,\n\n      input_type: \"voice\",\n\n      course_name: userContext.course_name || \"\",\nrating: userContext.rating ?? null,\nstudent_id: userContext.student_id || null,\n\n      received_at:\n        userContext.received_at ||\n        new Date().toISOString()\n    }\n  }\n];"
      },
