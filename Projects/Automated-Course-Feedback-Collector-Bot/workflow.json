    {
      "parameters": {
        "jsCode": "const currentFeedback =\n  $('Feedback Data Validator').first().json.feedback_text || \"\";\n\nconst rows = $input.all();\n\nconst normalizedCurrent =\n  String(currentFeedback).trim().toLowerCase();\n\nconst duplicateRow = rows.find(item => {\n  const sheetFeedback =\n    item.json.feedback_text || \"\";\n\n  return (\n    String(sheetFeedback).trim().toLowerCase() ===\n    normalizedCurrent\n  );\n});\n\nconst baseData =\n  $('Feedback Data Validator').first().json;\n\nreturn [\n  {\n    json: {\n      ...baseData,\n\n      row_number:\n        duplicateRow?.json.row_number || null,\n\n      is_duplicate:\n        !!duplicateRow,\n\n      duplicate_status:\n        duplicateRow ? \"Duplicate\" : \"New\"\n    }\n  }\n];"
      },
