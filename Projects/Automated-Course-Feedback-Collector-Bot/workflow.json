    {
      "parameters": {
        "jsCode": "\nconst message = $json.message || {};\nconst rawText = message.text || \"\";\n\nconst lines = rawText\n  .split(\"\\n\")\n  .map(line => line.trim())\n  .filter(Boolean);\n\n// Extract student name\nconst studentNameMatch = rawText.match(\n  /Student Name\\s*:\\s*(.+)/i\n);\n\n// Extract course name\nconst courseNameMatch = rawText.match(\n  /Course Name\\s*:\\s*(.+)/i\n);\n\n// Extract rating\nconst ratingMatch = rawText.match(\n  /Rating\\s*:\\s*(\\d+(?:\\.\\d+)?)\\s*\\/\\s*5/i\n);\n\nconst studentName =\n  studentNameMatch?.[1]?.trim() ||\n  message.from?.first_name ||\n  \"\";\n\nconst courseName =\n  courseNameMatch?.[1]?.trim() || \"\";\n\nconst rating = ratingMatch\n  ? Number(ratingMatch[1])\n  : null;\n\n// Remove metadata lines to get only feedback\nconst feedbackText = lines\n  .filter(line =>\n    !/^(Student Name|Course Name|Rating)\\s*:/i.test(line)\n  )\n  .join(\" \")\n  .trim();\n\nreturn [{\n  json: {\n    update_id: $json.update_id,\n    message_id: message.message_id,\n    user_id: message.from?.id || null,\n    user_name: message.from?.first_name || null,\n    username: message.from?.username || null,\n    chat_id: message.chat?.id || null,\n    chat_type: message.chat?.type || null,\n\n    student_name: studentName,\n    student_id: message.from?.id || null,\n    course_name: courseName,\n    rating: rating,\n\n    feedback_text: feedbackText,\n    message_date: message.date || null,\n    text: rawText,\n    has_text: !!message.text,\n    has_voice: !!message.voice,\n    voice_file_id: message.voice?.file_id || null,\n    input_type: message.voice ? \"voice\" : \"text\",\n    received_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
