      "id": "c32e741b-06f5-439b-940b-9964bf682170",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "jsCode": "\nconst data = $json;\n\nconst base = $('Feedback Data Validator').first().json;\nconst original = $('User Context Normalizer').first().json;\n\nconst rawOutput =\n  data.output ||\n  data.text ||\n  data.response ||\n  \"\";\n\nlet parsed;\n\ntry {\n  parsed = typeof rawOutput === \"string\"\n    ? JSON.parse(rawOutput)\n    : rawOutput;\n} catch (error) {\n  const match = String(rawOutput).match(/\\{[\\s\\S]*\\}/);\n\n  if (!match) {\n    throw new Error(\"AI Feedback Agent did not return valid JSON.\");\n  }\n\n  parsed = JSON.parse(match[0]);\n}\n\nreturn [{\n  json: {\n    ...data,\n\n    // Student information\n    student_name:\n      original.student_name ||\n      base.student_name ||\n      parsed.student_name ||\n      \"\",\n\n    student_id:\n      original.student_id ||\n      base.student_id ||\n      null,\n\n    course_name:\n      original.course_name ||\n      base.course_name ||\n      \"\",\n\n    // Preserve original student rating\n    rating:\n      original.rating ??\n      base.rating ??\n      parsed.rating ??\n      null,\n\n    // AI analysis\n    sentiment: parsed.sentiment || \"\",\n    topics: Array.isArray(parsed.topics) ? parsed.topics : [],\n    suggestions: Array.isArray(parsed.suggestions) ? parsed.suggestions : [],\n    priority: parsed.priority || \"\",\n\n    // Feedback details\n    feedback_text:\n      base.feedback_text ||\n      original.feedback_text ||\n      \"\",\n\n    chat_id: base.chat_id || original.chat_id || null,\n    user_id: base.user_id || original.user_id || null,\n\n    input_type: base.input_type || original.input_type || \"\",\n    received_at: base.received_at || original.received_at || null,\n\n    analyzed_at: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
