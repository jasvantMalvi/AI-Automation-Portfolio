{
  "name": "AI Attendance Intelligence Agent Using Airtable",
  "nodes": [
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5",
          "cachedResultName": "Claude Sonnet 5"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        640,
        192
      ],
      "id": "0d1fdf7f-09ba-4c5c-89fe-b2365136df4b",
      "name": "Anthropic Chat Model"
    },
    {
      "parameters": {
        "jsCode": "\nconst students = $input.all().map(item => item.json.fields);\n\n// Calculate attendance statistics\nconst totalStudents = students.length;\n\nconst totalClasses = students.reduce(\n  (sum, s) => sum + Number(s[\"Total Classes\"] || 0), 0\n);\n\nconst totalPresent = students.reduce(\n  (sum, s) => sum + Number(s[\"Present Days\"] || 0), 0\n);\n\nconst totalAbsent = students.reduce(\n  (sum, s) => sum + Number(s[\"Absent Days\"] || 0), 0\n);\n\nconst averageAttendance = totalClasses > 0\n  ? Number(((totalPresent / totalClasses) * 100).toFixed(2))\n  : 0;\n\n// Classify students\nconst criticalStudents = students.filter(\n  s => Number(s[\"Attendance Percentage\"] || 0) < 75\n);\n\nconst warningStudents = students.filter(\n  s => Number(s[\"Attendance Percentage\"] || 0) >= 75 &&\n       Number(s[\"Attendance Percentage\"] || 0) < 85\n);\n\nconst goodStudents = students.filter(\n  s => Number(s[\"Attendance Percentage\"] || 0) >= 85\n);\n\n// Identify excellent attendance\nconst excellentStudents = students.filter(\n  s => Number(s[\"Attendance Percentage\"] || 0) >= 95\n);\n\n// Student details for AI analysis\nconst studentDetails = students.map(s => ({\n  student_id: s[\"Student ID\"],\n  student_name: s[\"Student Name\"],\n  email: s.Email,\n  class: s.Class,\n  department: s.Department,\n  total_classes: Number(s[\"Total Classes\"] || 0),\n  present_days: Number(s[\"Present Days\"] || 0),\n  absent_days: Number(s[\"Absent Days\"] || 0),\n  attendance_percentage: Number(s[\"Attendance Percentage\"] || 0),\n  attendance_status: s[\"Attendance Status\"],\n  remarks: s.Remarks || \"\"\n}));\n\nreturn [{\n  json: {\n    report_date: new Date().toISOString(),\n    total_students: totalStudents,\n    total_classes: totalClasses,\n    total_present: totalPresent,\n    total_absent: totalAbsent,\n    average_attendance: averageAttendance,\n\n    good_students_count: goodStudents.length,\n    warning_students_count: warningStudents.length,\n    critical_students_count: criticalStudents.length,\n    excellent_students_count: excellentStudents.length,\n\n    critical_students: criticalStudents.map(s => ({\n      name: s[\"Student Name\"],\n      student_id: s[\"Student ID\"],\n      attendance: s[\"Attendance Percentage\"],\n      email: s.Email,\n      class: s.Class\n    })),\n\n    warning_students: warningStudents.map(s => ({\n      name: s[\"Student Name\"],\n      attendance: s[\"Attendance Percentage\"]\n    })),\n\n    excellent_students: excellentStudents.map(s => ({\n      name: s[\"Student Name\"],\n      attendance: s[\"Attendance Percentage\"]\n    })),\n\n    student_details: studentDetails\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "102965fa-3c45-4961-aa2f-878b5e9043e5",
