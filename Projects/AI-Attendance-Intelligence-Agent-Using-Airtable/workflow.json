    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json) }}",
        "options": {
          "systemMessage": "\nYou are an expert AI Attendance Intelligence Analyst.\n\nYour responsibility is to analyze student attendance data and generate a professional, accurate and actionable attendance intelligence report for the college administrator.\n\nANALYSIS TASKS:\n\n1. Analyze overall attendance performance.\n2. Evaluate average attendance and student distribution.\n3. Identify students with attendance below 75%.\n4. Identify students between 75% and 85%.\n5. Highlight students with attendance above 95%.\n6. Identify students who need immediate attention.\n7. Analyze class-wise and department-wise attendance.\n8. Identify potential attendance risks.\n9. Generate practical recommendations for administrators.\n\nIMPORTANT RULES:\n\n- Use only the supplied dataset.\n- Never invent student information or statistics.\n- Do not assume reasons for student absenteeism.\n- Do not claim attendance trends without historical data.\n- Prioritize students below 75%.\n- Keep recommendations realistic and actionable.\n- Verify that your reported counts match the supplied statistics.\n- Use professional and simple language.\n\nOUTPUT REQUIREMENT:\n\nReturn ONLY valid JSON without Markdown formatting.\n\nUse this exact structure:\n\n{\n  \"report_title\": \"AI Student Attendance Intelligence Report\",\n  \"executive_summary\": \"Overall attendance analysis\",\n  \"performance_analysis\": \"Detailed performance evaluation\",\n  \"attendance_insights\": [\n    \"Insight 1\",\n    \"Insight 2\",\n    \"Insight 3\"\n  ],\n  \"critical_students_analysis\": \"Analysis of students below 75%\",\n  \"warning_students_analysis\": \"Analysis of students between 75% and 85%\",\n  \"excellent_students_analysis\": \"Analysis of students above 95%\",\n  \"department_analysis\": \"Department-wise observations based on available data\",\n  \"risk_assessment\": \"Attendance risks and priorities\",\n  \"recommendations\": [\n    \"Recommendation 1\",\n    \"Recommendation 2\",\n    \"Recommendation 3\"\n  ],\n  \"priority_actions\": [\n    \"Immediate action 1\",\n    \"Immediate action 2\"\n  ],\n  \"conclusion\": \"Final administrator summary\"\n}\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        0
      ],
      "id": "7536406c-10f8-4e48-8240-3605cda9e410",
      "name": "\tAI Attendance Intelligence Analyst"
    },
    {
      "parameters": {
        "jsCode": "\nconst rawOutput = $input.first().json.output;\n\n// Parse AI JSON response\nconst report = typeof rawOutput === \"string\"\n  ? JSON.parse(rawOutput)\n  : rawOutput;\n\n// Get statistics from previous Code node\nconst stats = $('Process Student Attendance').first().json;\n\nconst insights = (report.attendance_insights || [])\n  .map(item => `<li>${item}</li>`).join('');\n\nconst recommendations = (report.recommendations || [])\n  .map(item => `<li>${item}</li>`).join('');\n\nconst actions = (report.priority_actions || [])\n  .map(item => `<li>${item}</li>`).join('');\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  background: #f4f6f9;\n  color: #263238;\n  padding: 20px;\n}\n.container {\n  max-width: 750px;\n  margin: auto;\n  background: #ffffff;\n  border-radius: 12px;\n  overflow: hidden;\n}\n.header {\n  background: #17365d;\n  color: white;\n  padding: 28px;\n  text-align: center;\n}\n.content { padding: 25px; }\n.cards {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n}\n.card {\n  background: #f1f5f9;\n  padding: 18px;\n  border-radius: 8px;\n}\n.value {\n  font-size: 25px;\n  font-weight: bold;\n  margin: 8px 0;\n}\n.section {\n  margin-top: 25px;\n  padding-bottom: 15px;\n  border-bottom: 1px solid #e5e7eb;\n}\nli { margin-bottom: 10px; }\n.footer {\n  background: #f1f5f9;\n  padding: 18px;\n  text-align: center;\n  font-size: 12px;\n  color: #64748b;\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n\n<div class=\"header\">\n  <h1>${report.report_title}</h1>\n  <p>Attendance Intelligence Dashboard</p>\n  <p>Report Date: ${new Date(stats.report_date).toLocaleDateString('en-IN')}</p>\n</div>\n\n<div class=\"content\">\n\n<div class=\"cards\">\n  <div class=\"card\">\n    <div>Total Students</div>\n    <div class=\"value\">${stats.total_students}</div>\n  </div>\n  <div class=\"card\">\n    <div>Average Attendance</div>\n    <div class=\"value\">${stats.average_attendance}%</div>\n  </div>\n  <div class=\"card\">\n    <div>Critical Students</div>\n    <div class=\"value\">${stats.critical_students_count}</div>\n  </div>\n  <div class=\"card\">\n    <div>Warning Students</div>\n    <div class=\"value\">${stats.warning_students_count}</div>\n  </div>\n</div>\n\n<div class=\"section\">\n<h2>Executive Summary</h2>\n<p>${report.executive_summary}</p>\n</div>\n\n<div class=\"section\">\n<h2>Performance Analysis</h2>\n<p>${report.performance_analysis}</p>\n</div>\n\n<div class=\"section\">\n<h2>Attendance Insights</h2>\n<ul>${insights}</ul>\n</div>\n\n<div class=\"section\">\n<h2>Critical Students Analysis</h2>\n<p>${report.critical_students_analysis}</p>\n</div>\n\n<div class=\"section\">\n<h2>Warning Students Analysis</h2>\n<p>${report.warning_students_analysis}</p>\n</div>\n\n<div class=\"section\">\n<h2>Excellent Students Analysis</h2>\n<p>${report.excellent_students_analysis}</p>\n</div>\n\n<div class=\"section\">\n<h2>Department Analysis</h2>\n<p>${report.department_analysis}</p>\n</div>\n\n<div class=\"section\">\n<h2>Risk Assessment</h2>\n<p>${report.risk_assessment}</p>\n</div>\n\n<div class=\"section\">\n<h2>AI Recommendations</h2>\n<ul>${recommendations}</ul>\n</div>\n\n<div class=\"section\">\n<h2>Priority Actions</h2>\n<ul>${actions}</ul>\n</div>\n\n<div class=\"section\">\n<h2>Conclusion</h2>\n<p>${report.conclusion}</p>\n</div>\n\n</div>\n\n<div class=\"footer\">\nGenerated automatically by AI Attendance Intelligence Agent\n</div>\n\n</div>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    report_id: `ATT-${Date.now()}`,\n    report_date: stats.report_date,\n    report_period: \"Weekly\",\n    total_students: stats.total_students,\n    average_attendance: stats.average_attendance,\n    good_students: stats.good_students_count,\n    warning_students: stats.warning_students_count,\n    critical_students: stats.critical_students_count,\n    ai_insights: report.attendance_insights,\n    recommendations: report.recommendations,\n    full_report_html: html,\n    email_status: \"Pending\",\n    email_subject: `Attendance Intelligence Report - ${new Date().toLocaleDateString('en-IN')}`\n  }\n}];\n"
      },
