      "name": "\tFetch LinkedIn Job Data"
    },
    {
      "parameters": {
        "jsCode": "\nconst jobs = items.map(item => ({\n  json: {\n    title: item.json.title || \"\",\n    company: item.json.company || item.json.companyName || \"\",\n    location: item.json.location || \"\",\n    link: item.json.link || \"\",\n    description: item.json.descriptionText || item.json.description || \"\",\n    posted_date: item.json.postedAt || item.json.date || \"\"\n  }\n}));\n\nreturn jobs;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        144
      ],
      "id": "7d940893-79ed-482c-b4f6-9e3e58d2b687",
      "name": "\tNormalize Job Data"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=\nAnalyze this LinkedIn job opportunity.\n\nJob Title: {{ $json.title }}\nCompany: {{ $json.company }}\nLocation: {{ $json.location }}\nApply Link: {{ $json.link }}\nJob Description: {{ $json.description }}\nPosted Date: {{ $json.posted_date }}\n\nCreate an accurate professional summary in 2 sentences.\n\nPreserve the original apply link.\nDo not invent missing information.\nReturn the result using the Structured Output Parser.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=\nYou are a Professional LinkedIn Job Recommendation Assistant.\n\nAnalyze the job information received from Apify.\n\nYour responsibilities:\n1. Extract the job title, company, location and apply link.\n2. Create a concise, accurate, professional job summary in 2 sentences.\n3. Extract the posting date if available.\n4. Generate a formatted notification.\n5. Never invent missing job information.\n6. If a field is unavailable, return an empty string.\n7. Preserve the original job application URL.\n\nReturn the output strictly according to the Structured Output Parser schema.\n\nDo not include Markdown code blocks or additional explanations.\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        656,
