      "name": "\tSave Jobs to Google Sheets"
    },
    {
      "parameters": {
        "jsCode": "\nlet emailBody = \"\";\n\nfor (const item of items) {\n  const job = item.json.output || item.json;\n\n  emailBody += `\n    <div style=\"padding:15px; margin-bottom:15px; border:1px solid #ddd; border-radius:8px;\">\n      <h3>${job.job_title || \"Job Opportunity\"}</h3>\n      <p><b>Company:</b> ${job.company || \"\"}</p>\n      <p><b>Location:</b> ${job.location || \"\"}</p>\n      <p>${job.summary || \"\"}</p>\n      <p>\n        <a href=\"${job.apply_link || \"#\"}\"\n           style=\"background:#0A66C2;color:white;padding:10px 16px;text-decoration:none;border-radius:5px;\">\n          Apply Now\n        </a>\n      </p>\n    </div>\n  `;\n}\n\nreturn [{\n  json: {\n    emailBody,\n    totalJobs: items.length\n  }\n}];\n"
      },
