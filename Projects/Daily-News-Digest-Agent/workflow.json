    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst seen = new Set();\nconst news = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  const title = String(data.title || '').trim();\n\n  if (!title) continue;\n\n  // Normalize title for duplicate detection\n  const key = title\n    .toLowerCase()\n    .replace(/[^\\w\\s]/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  if (seen.has(key)) continue;\n\n  seen.add(key);\n\n  const text = (\n    title + ' ' +\n    String(data.contentSnippet || '')\n  ).toLowerCase();\n\n  let score = 0;\n\n  // High importance\n  const high = [\n    'breaking',\n    'war',\n    'attack',\n    'election',\n    'president',\n    'prime minister',\n    'government',\n    'crisis',\n    'earthquake',\n    'ai',\n    'artificial intelligence',\n    'openai',\n    'google',\n    'microsoft',\n    'nvidia',\n    'economy',\n    'market crash'\n  ];\n\n  // Medium importance\n  const medium = [\n    'business',\n    'technology',\n    'startup',\n    'investment',\n    'market',\n    'science',\n    'space',\n    'health',\n    'security',\n    'cybersecurity',\n    'india',\n    'global',\n    'research'\n  ];\n\n  for (const word of high) {\n    if (text.includes(word)) score += 5;\n  }\n\n  for (const word of medium) {\n    if (text.includes(word)) score += 2;\n  }\n\n  news.push({\n    ...data,\n    importanceScore: score\n  });\n}\n\n// Sort most important first\nnews.sort((a, b) => b.importanceScore - a.importanceScore);\n\n// Return only 20\nreturn news.slice(0, 20).map(item => ({\n  json: item\n}));"
      },
