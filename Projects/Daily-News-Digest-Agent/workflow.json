    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following news article and return a structured analysis.\n\nHEADLINE:\n{{ $json.Headline }}\n\nDESCRIPTION:\n{{ $json.Description }}\n\nSOURCE:\n{{ $json.Source }}\n\nPUBLISHED DATE:\n{{ $json[\"Publish Date\"] }}\n\nTasks:\n\n1. Write a concise summary of the article in 2–3 sentences.\n2. Select exactly ONE category:\n   - AI & Technology\n   - Business & Economy\n   - World News\n   - Science & Space\n   - India News\n\n3. Determine the sentiment:\n   - Positive\n   - Neutral\n   - Negative\n\n4. Determine the trend signal:\n   - Rising\n   - Stable\n   - Declining\n   - Emerging\n\nImportant rules:\n- Base the analysis only on the information provided.\n- Do not invent facts.\n- Keep the summary factual and concise.\n- Return exactly one category, one sentiment, and one trend.\n- Do not include explanations outside the requested output format.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a professional news analysis assistant.  Your job is to analyze one news article at a time and produce accurate, concise, structured information.  Do not invent facts or add information that is not supported by the article.  Follow the allowed categories, sentiment values, and trend values exactly.  The summary must be factual and 2–3 sentences long."
            }
          ]
        },
        "batching": {}
