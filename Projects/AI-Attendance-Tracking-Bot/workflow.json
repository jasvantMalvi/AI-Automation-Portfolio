    {
      "parameters": {
        "jsCode": "// Get WhatsApp payload\nconst data = $input.first().json;\n\nconst contact = data.contacts?.[0] || {};\nconst message = data.messages?.[0] || {};\n\n// User details\nconst name = contact.profile?.name || \"\";\nconst mobile = message.from || contact.wa_id || \"\";\n\n// Attendance message\nconst attendance = (message.text?.body || \"\").trim();\n\n// Convert WhatsApp timestamp (UTC) to India Time\nconst dateObj = new Date(Number(message.timestamp) * 1000);\n\n// Format for India\nconst options = {\n  timeZone: \"Asia/Kolkata\",\n};\n\n// Date (DD/MM/YYYY)\nconst date = dateObj.toLocaleDateString(\"en-GB\", options);\n\n// Time (HH:MM:SS)\nconst time = dateObj.toLocaleTimeString(\"en-GB\", {\n  ...options,\n  hour12: false,\n});\n\n// ISO Timestamp\nconst timestamp = dateObj.toISOString();\n\nreturn [\n  {\n    json: {\n      name,\n      mobile,\n      attendance,\n      date,\n      time,\n      timestamp\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
