    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\n\nconst allowed = [\n  'Pending',\n  'Analyzing',\n  'Awaiting Approval',\n  'Assigned',\n  'In Progress',\n  'On Hold',\n  'Completed',\n  'Rejected',\n  'Escalated'\n];\n\nif (!b.ticket_id || !allowed.includes(b.status)) {\n  return [{\n    json: {\n      success: false,\n      error: 'Valid ticket_id and status required'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    ticket_id: String(b.ticket_id),\n    status: b.status,\n    resolution_notes: String(b.resolution_notes ?? ''),\n    updated_at: new Date().toISOString(),\n    message: 'Status validated successfully'\n  }\n}];"
      },
      "id": "ab0c574a-3021-41d5-b6c0-e7f780e8d8f6",
      "name": "Validate Status",
