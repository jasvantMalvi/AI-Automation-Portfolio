    {
      "parameters": {
        "jsCode": "// Birthday Reminder Bot\n// Mode: Run Once for All Items\n\nconst today = new Date();\n\n// Today's Month & Day\nconst todayMonth = String(today.getMonth() + 1).padStart(2, '0');\nconst todayDay = String(today.getDate()).padStart(2, '0');\n\n// Today's date (YYYY-MM-DD)\nconst todayDate = today.toISOString().split('T')[0];\n\nconst birthdayPeople = [];\n\nfor (const item of $input.all()) {\n\n  const person = item.json;\n\n  // Skip if Birthday is missing\n  if (!person[\"Birthday\"]) continue;\n\n  // Skip inactive contacts\n  if (\n    person[\"Status\"] &&\n    person[\"Status\"].toString().toLowerCase() !== \"active\"\n  ) {\n    continue;\n  }\n\n  // Skip if already wished today\n  if (\n    person[\"Birthday Wish Sent\"]?.toString().toLowerCase() === \"yes\" &&\n    person[\"Last Wish Date\"] === todayDate\n  ) {\n    continue;\n  }\n\n  // Parse birthday\n  const birthday = new Date(person[\"Birthday\"]);\n\n  if (isNaN(birthday.getTime())) continue;\n\n  const birthMonth = String(birthday.getMonth() + 1).padStart(2, '0');\n  const birthDay = String(birthday.getDate()).padStart(2, '0');\n\n  // Birthday Match\n  if (birthMonth === todayMonth && birthDay === todayDay) {\n\n    birthdayPeople.push({\n      json: {\n        row_number: person.row_number,\n        id: person.ID,\n        full_name: person[\"Full Name\"],\n        phone_number: person[\"Phone Number\"],\n        birthday: person[\"Birthday\"],\n        relationship: person[\"Relationship\"],\n        city: person[\"City\"],\n        status: person[\"Status\"],\n        birthday_wish_sent: person[\"Birthday Wish Sent\"],\n        last_wish_date: person[\"Last Wish Date\"],\n        today: todayDate,\n        occasion: \"Birthday\",\n        should_send_message: true\n      }\n    });\n\n  }\n}\n\nreturn birthdayPeople;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
