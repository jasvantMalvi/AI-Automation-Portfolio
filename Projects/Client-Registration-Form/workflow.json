d style=\"padding:12px;font-weight:bold;\">Course</td>\n<td style=\"padding:12px;\">{{ $json['Cources'] }}</td>\n</tr>\n\n<tr>\n<td style=\"padding:12px;font-weight:bold;\">City</td>\n<td style=\"padding:12px;\">{{ $json['City'] }}</td>\n</tr>\n\n<tr style=\"background:#ffffff;\">\n<td style=\"padding:12px;font-weight:bold;\">Gender</td>\n<td style=\"padding:12px;\">{{ $json['Gender'][0] }}</td>\n</tr>\n\n<tr>\n<td style=\"padding:12px;font-weight:bold;\">Message</td>\n<td style=\"padding:12px;\">{{ $json['Message'] }}</td>\n</tr>\n\n</table>\n\n<!-- CTA -->\n<div style=\"text-align:center;margin-top:35px;\">\n<a href=\"https://yourwebsite.com\"\nstyle=\"background:#4f46e5;color:#ffffff;text-decoration:none;padding:14px 30px;border-radius:8px;font-weight:bold;display:inline-block;\">\nVisit Our Website\n</a>\n</div>\n\n<p style=\"font-size:15px;color:#4b5563;line-height:1.7;margin-top:30px;\">\nOur admission team will review your registration and reach out with the next steps.\n</p>\n\n<p style=\"margin-top:25px;color:#111827;\">\nBest Regards,<br>\n<strong>Admissions Team</strong><br>\nYour Institute Name\n</p>\n\n</td>\n</tr>\n\n<!-- Footer -->\n<tr>\n<td style=\"background:#111827;color:#d1d5db;text-align:center;padding:25px;font-size:13px;\">\n© 2026 Your Institute. All Rights Reserved.<br>\nAhmedabad, Gujarat, India\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
