    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify the following email:\n\nSubject: {{ $json.Subject }}\nFrom: {{ $json.From }}\nEmail Body: {{ $json.snippet }}\n\nReturn exactly one line in this format:\nCategory | Priority | Summary",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an Email Classifier AI Agent.\n\nAnalyze the email and classify it into:\n- category\n- priority\n- summary\n\nPriority must be exactly one of: High, Medium, Low.\n\nCategory should be short and relevant, such as Security, Finance, Work, HR, Promotion, Newsletter, Support, etc.\n\nSummary must be one concise sentence describing the main purpose or action of the email.\n\nReturn only the required structured output. Do not add explanations or extra fields."
        }
      },
