      "id": "ec5d81ce-51b9-4c71-a6bc-256e537a7c5f",
      "name": "Fetch Grocery User Data"
    },
    {
      "parameters": {
        "jsCode": "// Get all rows from the Google Sheet\nconst items = $input.all();\nconst today = new Date(); // Current date\n\nconst restockList = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  if (data.LastPurchaseDate && data.RestockDays) {\n    const lastDate = new Date(data.LastPurchaseDate);\n    const restockDays = parseInt(data.RestockDays, 10);\n    \n    // Calculate difference in days\n    const diffTime = Math.abs(today - lastDate);\n    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n    \n    // Check if restock is due\n    if (diffDays >= restockDays) {\n      restockList.push({\n        json: {\n          name: data.Name,\n          chatId: data.ChatId,\n          lastItem: data.LastItem,\n          daysPassed: diffDays,\n          restockDays: restockDays\n        }\n      });\n    }\n  }\n}\n\n// Return only users who need restock\nreturn restockList;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "95d7761d-843c-4804-8a0b-570adc4fcbb8",
      "name": "Check Restock Eligibility"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Here is the user detail who needs a grocery restock:\n- User Name: {{ $json.name }}\n- Last Purchased Items: {{ $json.lastItem }}\n- Days Passed Since Last Purchase: {{ $json.daysPassed }} days\n- Expected Restock Cycle: {{ $json.restockDays }} days\n\nPlease write a personalized restock reminder message for this user.",
        "options": {
          "systemMessage": "You are an intelligent Grocery Restock Reminder Assistant. Your job is to generate friendly, polite, and catchy reminder messages for users whose grocery stock is about to finish or has finished based on their past purchase history.\n- Keep the message personalized using their name.\n- Mention the items they likely need to restock.\n- Keep it short, encouraging, and easy to read on Telegram."
        }
      },
