      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "// Extract incoming Telegram message details safely\nconst message = $input.item.json.message;\n\nconst text = message && message.text ? message.text : \"\";\nconst chatId = message && message.chat ? message.chat.id : \"\";\nconst userName = message && message.from ? (message.from.first_name || \"User\") : \"User\";\n\n// Return the cleaned data to the next node\nreturn {\n  json: {\n    text: text,\n    chatId: chatId,\n    userName: userName\n  }\n};"
      },
