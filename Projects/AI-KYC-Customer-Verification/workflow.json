      "parameters": {
        "jsCode": "const data = $json;\n\nreturn [{\n  json: {\n    ...data,\n    ocr_status: 'READY',\n    name: 'Test User',\n    document_number: 'TEST123456',\n    address: 'Ahmedabad, Gujarat',\n    confidence: 0.95\n  }\n}];"
