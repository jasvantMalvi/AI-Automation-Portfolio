    {
      "parameters": {
        "jsCode": "const a = String($json.extracted_name || '').trim().toLowerCase();\nconst b = String($json.normalized_name || '').trim().toLowerCase();\n\nreturn [{\n  json:{\n    ...$json,\n    customer_name:a,\n    name_match:a && b && a===b\n  }\n}];"
