      "parameters": {
        "jsCode": "let s=0;\n\nif($json.risk_flag)\n  s+=60;\n\nif(!$json.address_verified)\n  s+=20;\n\nif(($json.ocr_confidence||0)<.9)\n  s+=10;\n\nreturn [{\n  json:{\n    ...$json,\n    risk_score:s,\n    risk_level:s>=70?'HIGH':s>=40?'MEDIUM':'LOW'\n  }\n}];"
      },
