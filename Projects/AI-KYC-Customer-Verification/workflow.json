    {
      "parameters": {
        "jsCode": "\nconst m = $json.message || {};\n\nconst isDocument = !!m.document;\nconst isStartCommand = (m.text || '').trim() === '/start';\n\nreturn [{\n  json: {\n    chat_id: m.chat?.id || '',\n    message_id: m.message_id || '',\n    username: m.from?.username || '',\n    first_name: m.from?.first_name || '',\n\n    text: m.text || '',\n    is_start_command: isStartCommand,\n    has_document: isDocument,\n\n    file_id: m.document?.file_id || '',\n    file_name: m.document?.file_name || '',\n    mime_type: m.document?.mime_type || '',\n    file_size: m.document?.file_size || 0,\n\n    message_type: isDocument ? 'DOCUMENT' : 'TEXT',\n\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "47e00ac1-a2fa-4cb0-88a9-626f06fc6d4a",
