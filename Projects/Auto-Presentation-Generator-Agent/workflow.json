        "message": "= <!DOCTYPE html> <html> <head> <meta charset=\"UTF-8\"> </head>  <body style=\"margin:0;padding:25px;background:#f1f5f9;font-family:Arial,sans-serif;\">  <div style=\"max-width:600px;margin:auto;background:#ffffff;border-radius:12px;overflow:hidden;\">    <!-- Header -->   <div style=\"background:#1e40af;padding:30px;text-align:center;color:#ffffff;\">     <h1 style=\"margin:0;font-size:25px;\">       Your Presentation is Ready!     </h1>     <p style=\"font-size:14px;margin-bottom:0;\">       Successfully generated by AI     </p>   </div>    <!-- Main Content -->   <div style=\"padding:30px;color:#334155;\">      <h2 style=\"font-size:20px;color:#0f172a;\">       Hello,     </h2>      <p style=\"font-size:15px;line-height:1.7;\">       Great news! Your requested presentation has been       successfully generated. Your Google Slides presentation       is now ready to view and edit.     </p>      <!-- Details -->     <div style=\"background:#f8fafc;border:1px solid #e2e8f0;                 border-radius:8px;padding:20px;margin:25px 0;\">        <h3 style=\"margin-top:0;color:#1e40af;\">         Presentation Details       </h3>        <p><strong>Topic:</strong>         {{ $('Presentation Request Form').first().json['Presentation Topic'] }}       </p>        <p><strong>Presentation Type:</strong>         {{ $('Presentation Request Form').first().json['Presentation Type'] }}       </p>        <p><strong>Number of Slides:</strong>         {{ $('Presentation Request Form').first().json['Number of Slides'] }}       </p>        <p><strong>Target Audience:</strong>         {{ $('Presentation Request Form').first().json['Target Audience'] }}       </p>        <p><strong>Language:</strong>         {{ $('Presentation Request Form').first().json['Presentation Language'] }}       </p>      </div>      <!-- Presentation Button -->     <div style=\"text-align:center;margin:30px 0;\">        <a href=\"https://docs.google.com/presentation/d/{{ $('Duplicate Master Presentation').first().json.id }}/edit\"          style=\"background:#1e40af;color:#ffffff;                 padding:15px 28px;text-decoration:none;                 border-radius:7px;font-size:15px;                 font-weight:bold;display:inline-block;\">          Open Google Slides Presentation        </a>      </div>      <p style=\"font-size:14px;line-height:1.7;\">       You can now review, edit and present your slides       directly in Google Slides.     </p>      <p style=\"font-size:14px;\">       Thank you for using our AI Presentation Generator!     </p>    </div>    <!-- Footer -->   <div style=\"background:#f8fafc;padding:20px;text-align:center;               color:#64748b;font-size:12px;\">      <p style=\"margin:5px;\">       <strong>AI Presentation Generator</strong>     </p>      <p style=\"margin:5px;\">       Powered by n8n and Artificial Intelligence     </p>      <p style=\"margin:5px;\">       Automated Presentation Creation System     </p>    </div>  </div>  </body> </html>",
