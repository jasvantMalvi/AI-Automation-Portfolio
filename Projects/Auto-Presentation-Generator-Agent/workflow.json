    {
      "parameters": {
        "promptType": "define",
        "text": "=Generate a professional six-slide educational presentation.\n\nTOPIC: {{ $('Presentation Request Form').first().json['Presentation Topic'] }}\nTYPE: {{ $('Presentation Request Form').first().json['Presentation Type'] }}\nAUDIENCE: {{ $('Presentation Request Form').first().json['Target Audience'] }}\nLANGUAGE: {{ $('Presentation Request Form').first().json['Presentation Language'] }}\n\nCreate the following six slides:\n\nSLIDE 1 – COVER\nGenerate a presentation title and subtitle.\n\nSLIDE 2 – INTRODUCTION\nGenerate a suitable title and exactly 3 informative bullet points.\n\nSLIDE 3 – KEY CONCEPTS\nGenerate a suitable title and exactly 3 informative bullet points.\n\nSLIDE 4 – DETAILED EXPLANATION\nGenerate a suitable title and exactly 3 informative bullet points.\n\nSLIDE 5 – APPLICATIONS\nGenerate a suitable title and exactly 3 informative bullet points.\n\nSLIDE 6 – CONCLUSION\nGenerate a suitable title and exactly 3 informative bullet points.\n\nIMPORTANT:\n- Return all slide points in one string per slide.\n- Separate each bullet point using a newline.\n- Keep each bullet concise and informative.\n- Match the presentation language.\n- Return only the exact JSON structure required by the output parser.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a professional educational presentation generator.\n\nCreate accurate, clear and engaging presentation content.\n\nRules:\n- Generate content for exactly six fixed slides.\n- Use simple language suitable for the target audience.\n- Follow the specified slide structure.\n- Slides 2–6 must each have exactly three concise bullet points.\n- Keep titles short and professional.\n- Avoid repetition and lengthy paragraphs.\n- Use scientifically accurate information when discussing scientific topics.\n- Return all required fields as strings.\n- Follow the connected Structured Output Parser schema exactly.\n- Never add extra fields.\n- Never return Markdown or explanations outside the structured output."
        }
      },
