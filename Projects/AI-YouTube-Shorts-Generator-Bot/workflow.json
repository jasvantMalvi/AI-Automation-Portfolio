      "parameters": {
        "jsCode": "\nconst videos = $input.first().json.output.videos;\n\nreturn videos.map((video, index) => ({\n  json: {\n    id: Date.now() + index,\n    video_title: video.video_title || \"\",\n    hook: video.hook || \"\",\n    script: video.script || \"\",\n    ending: video.ending || \"\",\n    hashtags: Array.isArray(video.hashtags)\n      ? video.hashtags.join(\" \")\n      : \"\",\n    article_title: video.article_title || \"\",\n    article_link: video.article_link || \"\",\n    creator: video.creator || \"\",\n    published_date: video.published_date || \"\",\n    status: \"Generated\",\n    generated_at: $now.setZone(\"Asia/Kolkata\").toFormat(\"yyyy-LL-dd HH:mm:ss\")\n  }\n}));\n"
      },
