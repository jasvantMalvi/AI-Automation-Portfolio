    {
      "parameters": {
        "sendTo": "={{ $('Edit Fields1').item.json.recipientEmail }}",
        "subject": "=Your {{ $('Edit Fields1').item.json.courseName }} Certificate Is Ready",
        "message": "=\n={{\n  (() => {\n    const d = $('Edit Fields1').item.json;\n\n    const esc = (v) => String(v ?? '').replace(/[&<>\"']/g, c => ({\n      '&': '&amp;',\n      '<': '&lt;',\n      '>': '&gt;',\n      '\"': '&quot;',\n      \"'\": '&#39;'\n    })[c]);\n\n    return `\n    <div style=\"margin:0;padding:30px 12px;background:#f3f5f9;font-family:Arial,sans-serif;color:#243047;\">\n      <div style=\"max-width:600px;margin:auto;background:#ffffff;border-radius:12px;overflow:hidden;\">\n\n        <div style=\"padding:26px 30px;background:#183153;color:#ffffff;\">\n          <h1 style=\"margin:0;font-size:23px;\">Your Certificate Is Ready!</h1>\n          <p style=\"margin:8px 0 0;font-size:14px;\">Course Completion Certificate</p>\n        </div>\n\n        <div style=\"padding:30px;\">\n          <p style=\"font-size:16px;\">Hello ${esc(d.recipientName)},</p>\n\n          <p style=\"font-size:15px;line-height:1.7;\">\n            Congratulations on successfully completing\n            <strong>${esc(d.courseName)}</strong>!\n            Your personalized certificate has been generated and is ready to view.\n          </p>\n\n          <div style=\"margin:26px 0;padding:20px;background:#f5f7fb;border:1px solid #e0e6ef;border-radius:8px;\">\n            <p style=\"margin:0 0 8px;font-size:12px;color:#65738a;\">CERTIFICATE DETAILS</p>\n            <p style=\"margin:0 0 12px;font-size:17px;font-weight:bold;\">\n              ${esc(d.recipientName)}\n            </p>\n            <p style=\"margin:0 0 8px;font-size:14px;\">\n              <strong>Course:</strong> ${esc(d.courseName)}\n            </p>\n            <p style=\"margin:0;font-size:14px;\">\n              <strong>Certificate ID:</strong> ${esc(d.certificateId)}\n            </p>\n          </div>\n\n          <p style=\"text-align:center;margin:30px 0;\">\n            <a href=\"${esc(d.certificateLink)}\"\n               style=\"display:inline-block;padding:14px 24px;background:#1d5fd0;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;\">\n              View My Certificate\n            </a>\n          </p>\n\n          <p style=\"font-size:14px;line-height:1.7;\">\n            Please keep this link for your records. If you experience any\n            difficulty accessing your certificate, reply to this email for assistance.\n          </p>\n\n          <p style=\"font-size:14px;line-height:1.7;\">\n            Best regards,<br>\n            <strong>Certificate Administration Team</strong>\n          </p>\n        </div>\n\n        <div style=\"padding:16px 30px;background:#f7f8fa;color:#7a8597;font-size:12px;text-align:center;\">\n          This is an automated certificate delivery email.\n        </div>\n\n      </div>\n    </div>`;\n  })()\n}}\n",
        "options": {}
      },
