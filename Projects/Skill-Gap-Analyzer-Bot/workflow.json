    {
      "parameters": {
        "sendTo": "={{ $('On form submission').item.json['Email Address'] }}",
        "subject": "=Your Skill Gap Analysis Report – {{ $('On form submission').item.json['Target Job Role'] }}",
        "message": "=<!DOCTYPE html> <html> <head>   <meta charset=\"UTF-8\">   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"> </head>  <body style=\"margin:0; padding:0; background:#f4f6f8; font-family:Arial, Helvetica, sans-serif; color:#263238;\">  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f4f6f8; padding:30px 15px;\"> <tr> <td align=\"center\">  <table width=\"680\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:680px; width:100%; background:#ffffff; border-radius:12px; overflow:hidden;\">  <!-- HEADER --> <tr> <td style=\"background:#1f2937; padding:30px 35px;\">  <h1 style=\"margin:0; color:#ffffff; font-size:26px;\"> Skill Gap Analysis </h1>  <p style=\"margin:8px 0 0; color:#d1d5db; font-size:14px;\"> Your personalized career readiness report </p>  </td> </tr>   <!-- CANDIDATE INFO --> <tr> <td style=\"padding:30px 35px 15px;\">  <p style=\"margin:0 0 5px; font-size:14px; color:#6b7280;\"> Hello, </p>  <h2 style=\"margin:0 0 20px; font-size:22px; color:#111827;\"> {{ $('On form submission').item.json['Full Name'] }} </h2>  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">  <tr> <td style=\"padding:8px 0; font-size:14px;\"> <strong>Target Role:</strong> {{ $('On form submission').item.json['Target Job Role'] }} </td> </tr>  <tr> <td style=\"padding:8px 0; font-size:14px;\"> <strong>Experience Level:</strong> {{ $json['EXPERIENCE LEVEL'] }} </td> </tr>  </table>  </td> </tr>   <!-- READINESS SCORE --> <tr> <td style=\"padding:15px 35px 25px;\">  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f8fafc; border:1px solid #e5e7eb; border-radius:10px;\">  <tr> <td align=\"center\" style=\"padding:25px;\">  <p style=\"margin:0 0 8px; color:#6b7280; font-size:13px; text-transform:uppercase; letter-spacing:1px;\"> Job Readiness Score </p>  <div style=\"font-size:42px; font-weight:bold; color:#111827;\"> {{ $('AI Agent').item.json.output.readiness_score }}% </div>  <p style=\"margin:8px 0 0; color:#6b7280; font-size:13px;\"> Based on your resume and the requirements of your target role </p>  </td> </tr>  </table>  </td> </tr>   <!-- USER SKILLS --> <tr> <td style=\"padding:10px 35px;\">  <h2 style=\"font-size:18px; color:#111827; margin:0 0 12px;\"> Your Skills </h2>  <div style=\"background:#f8fafc; border-left:4px solid #374151; padding:15px; border-radius:6px; font-size:14px; line-height:1.7;\"> {{ $('AI Agent').item.json.output.user_skills }} </div>  </td> </tr>   <!-- MATCHING SKILLS --> <tr> <td style=\"padding:20px 35px 10px;\">  <h2 style=\"font-size:18px; color:#111827; margin:0 0 12px;\"> Skills Matching the Target Role </h2>  <div style=\"background:#f0fdf4; border-left:4px solid #16a34a; padding:15px; border-radius:6px; font-size:14px; line-height:1.7;\"> {{ $('AI Agent').item.json.output.matching_skills }} </div>  </td> </tr>   <!-- MISSING SKILLS --> <tr> <td style=\"padding:20px 35px 10px;\">  <h2 style=\"font-size:18px; color:#111827; margin:0 0 12px;\"> Skills to Develop </h2>  <div style=\"background:#fff7ed; border-left:4px solid #f97316; padding:15px; border-radius:6px; font-size:14px; line-height:1.7;\"> {{ $json['MISSING SKILLS'] }} </div>  </td> </tr>   <!-- RECOMMENDATION --> <tr> <td style=\"padding:20px 35px 10px;\">  <h2 style=\"font-size:18px; color:#111827; margin:0 0 12px;\"> Recommended Next Steps </h2>  <div style=\"background:#eff6ff; border-left:4px solid #2563eb; padding:15px; border-radius:6px; font-size:14px; line-height:1.7;\"> {{ $json.RECOMMENDATION }} </div>  </td> </tr>   <!-- ROADMAP --> <tr> <td style=\"padding:20px 35px 30px;\">  <h2 style=\"font-size:18px; color:#111827; margin:0 0 15px;\"> Your Learning Roadmap </h2>   <div style=\"border:1px solid #e5e7eb; border-radius:8px; padding:18px; margin-bottom:10px;\">  <strong style=\"font-size:15px; color:#111827;\"> Short Term </strong>  <p style=\"margin:8px 0 0; font-size:14px; line-height:1.7; color:#4b5563;\"> {{ $json.ROADMAP.short_term }} </p>  </div>   <div style=\"border:1px solid #e5e7eb; border-radius:8px; padding:18px; margin-bottom:10px;\">  <strong style=\"font-size:15px; color:#111827;\"> Medium Term </strong>  <p style=\"margin:8px 0 0; font-size:14px; line-height:1.7; color:#4b5563;\"> {{ $json.ROADMAP.medium_term }} </p>  </div>   <div style=\"border:1px solid #e5e7eb; border-radius:8px; padding:18px;\">  <strong style=\"font-size:15px; color:#111827;\"> Long Term </strong>  <p style=\"margin:8px 0 0; font-size:14px; line-height:1.7; color:#4b5563;\"> {{ $json.ROADMAP.long_term }} </p>  </div>  </td> </tr>   <!-- FOOTER --> <tr> <td style=\"background:#f8fafc; padding:22px 35px; border-top:1px solid #e5e7eb;\">  <p style=\"margin:0; font-size:12px; color:#6b7280; line-height:1.6;\"> This report was generated automatically by the Skill Gap Analyzer.  The assessment is based on the information provided in your resume and the selected job requirements. </p>  <p style=\"margin:12px 0 0; font-size:12px; color:#9ca3af;\"> Keep learning. Keep building. Keep improving. </p>  </td> </tr>  </table>  </td> </tr> </table>  </body> </html>",
