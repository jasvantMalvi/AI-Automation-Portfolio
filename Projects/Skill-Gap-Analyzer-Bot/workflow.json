    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"name\": \"\",\n  \"email\": \"\",\n  \"target_job_role\": \"AI Automation Specialist\",\n  \"experience_level\": \"0-1 Yrs\",\n  \"user_skills\": [\n    \"JavaScript\",\n    \"Python\",\n    \"SQL\",\n    \"n8n\",\n    \"Workflow Automation\",\n    \"Webhooks\",\n    \"REST APIs\",\n    \"Google Sheets\",\n    \"Gmail Integration\",\n    \"Generative AI\",\n    \"Prompt Engineering\",\n    \"AI APIs\",\n    \"MySQL\",\n    \"Postman\",\n    \"Git\",\n    \"GitHub\",\n    \"HTML\",\n    \"CSS\",\n    \"Problem Solving\",\n    \"Workflow Design\",\n    \"Logical Thinking\",\n    \"Quick Learning\",\n    \"Communication\"\n  ],\n  \"matching_skills\": [\n    \"Workflow automation using n8n\",\n    \"Webhooks and Google Sheets\",\n    \"JavaScript\",\n    \"Generative AI\",\n    \"AI APIs\",\n    \"Python and SQL\",\n    \"REST APIs\",\n    \"Git/GitHub\"\n  ],\n  \"missing_skills\": [\n    \"Docker\",\n    \"Cloud platforms\",\n    \"LangChain\",\n    \"Machine Learning\",\n    \"CI/CD\",\n    \"Advanced Python\",\n    \"System Design\",\n    \"Security\"\n  ],\n  \"recommendation\": \"Focus on Docker, cloud deployment, LangChain, advanced Python, CI/CD, and production-level AI automation.\",\n  \"roadmap\": {\n    \"short_term\": \"Learn Docker, advanced Python, REST APIs and production-ready n8n workflows.\",\n    \"medium_term\": \"Build AI agent projects using LangChain and vector databases and deploy them on a cloud platform.\",\n    \"long_term\": \"Develop skills in system design, CI/CD, monitoring, security and scalable AI automation.\"\n  },\n  \"readiness_score\": 70\n}"
      },
