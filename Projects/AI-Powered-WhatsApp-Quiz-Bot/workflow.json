        "jsCode": "const responses = $input.all().map(item => item.json);\n\nconst totalQuestions = responses.length;\n\nconst score = responses.filter(r =>\n    String(r.Is_Correct).toLowerCase() === \"true\"\n).length;\n\nconst wrong = totalQuestions - score;\n\nconst percentage = ((score / totalQuestions) * 100).toFixed(0);\n\nconst phoneNo = responses[0].Phone_No;\n\nlet answerSummary = \"\";\n\nresponses.forEach((r, index) => {\n    const status = String(r.Is_Correct).toLowerCase() === \"true\" ? \"✅\" : \"❌\";\n\n    answerSummary += `${status} Q${index + 1}: Your Answer ${r.Student_Answer} | Correct ${r.Correct_Answer}\\n`;\n});\n\nconst message = `🏆 *QUIZ COMPLETED!* 🏆\n\n━━━━━━━━━━━━━━━━━━\n\n📊 *Your Result*\n\n✅ Correct Answers : *${score}/${totalQuestions}*\n❌ Wrong Answers : *${wrong}*\n📈 Score : *${percentage}%*\n\n━━━━━━━━━━━━━━━━━━\n\n📋 *Answer Summary*\n\n${answerSummary}\n\n🎉 Thank you for participating!\nKeep learning and keep growing! 🚀`;\n\nreturn [{\n    json: {\n        phoneNo,\n        totalQuestions,\n        score,\n        wrong,\n        percentage,\n        resultMessage: message\n    }\n}];"
      },
