    {
      "parameters": {
        "jsCode": "// Get question data from Google Sheet\nconst question = $input.first().json;\n\n// Get student's answer from the Edit Fields node\nconst studentAnswer = $('Edit Fields').first().json.Answer;\n\n// Get correct answer from Google Sheet\nconst correctAnswer = question.Correct_Answer\n  .toString()\n  .trim()\n  .toUpperCase();\n\n// Validate\nconst isCorrect = studentAnswer === correctAnswer;\nconst score = isCorrect ? 1 : 0;\n\n// Return result\nreturn [\n  {\n    json: {\n      questionId: question.Question_ID,\n      studentAnswer,\n      correctAnswer,\n      is_correct: isCorrect,\n      score\n    }\n  }\n];"
      },
