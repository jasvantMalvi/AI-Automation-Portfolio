      "parameters": {
        "jsCode": "const q = $input.first().json;\n\nconst message = `🎯 *QUIZ TIME!* 🎯\n\n📖 *Question ${q.Question_ID.replace(\"Q\", \"\")}*\n\n${q.Question}\n\nA. ${q.Option_A}\nB. ${q.Option_B}\nC. ${q.Option_C}\nD. ${q.Option_D}\n\n━━━━━━━━━━━━━━━━━━\n\n✍️ *Reply with only:*\n*A*, *B*, *C* or *D* `;\n\n\nreturn [\n  {\n    json: {\n      questionMessage: message,\n      questionId: q.Question_ID,\n      correctAnswer: q.Correct_Answer\n    }\n  }\n];"
      },
