      "id": "b98d4db5-7622-42e1-a825-15e8d817f872",
      "name": "Get Bills from Google Sheets"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst todayStr = new Intl.DateTimeFormat(\"en-CA\", {\n  timeZone: \"Asia/Kolkata\",\n  year: \"numeric\",\n  month: \"2-digit\",\n  day: \"2-digit\"\n}).format(new Date());\n\nfunction getDateKey(value) {\n  if (!value) return \"\";\n\n  const str = String(value).trim();\n\n  // YYYY-MM-DD\n  const iso = str.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;\n\n  // DD/MM/YYYY\n  const indian = str.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n  if (indian) return `${indian[3]}-${indian[2]}-${indian[1]}`;\n\n  return \"\";\n}\n\nfunction dayNumber(date) {\n  const [y, m, d] = date.split(\"-\").map(Number);\n  return Date.UTC(y, m - 1, d) / 86400000;\n}\n\nconst todayNumber = dayNumber(todayStr);\nconst alerts = [];\n\nfor (const item of items) {\n  const bill = item.json;\n\n  // Only unpaid bills\n  if (\n    String(bill.PaymentStatus || \"\").trim().toLowerCase()\n    !== \"unpaid\"\n  ) continue;\n\n  if (!bill.BillID || !bill.ChatID || !bill.DueDate) continue;\n\n  const dueDate = getDateKey(bill.DueDate);\n  if (!dueDate) continue;\n\n  const daysRemaining = dayNumber(dueDate) - todayNumber;\n\n  const reminderDays = String(bill.ReminderDays || \"7,3,1,0\")\n    .split(\",\")\n    .map(x => Number(x.trim()));\n\n  let reminderType = \"\";\n  let timingMessage = \"\";\n\n  if (daysRemaining < 0) {\n    reminderType = \"overdue\";\n    timingMessage = \"🚨 OVERDUE BILL!\";\n  } else if (reminderDays.includes(daysRemaining)) {\n    reminderType = `due_in_${daysRemaining}_days`;\n\n    timingMessage = daysRemaining === 0\n      ? \"🚨 BILL DUE TODAY!\"\n      : `⚠️ BILL DUE IN ${daysRemaining} DAYS!`;\n  } else {\n    continue;\n  }\n\n  // Check previous reminder history\n  const previousDate = getDateKey(bill.LastReminderDate);\n  const previousType = String(bill.LastReminderType || \"\").trim();\n\n  // Skip if same reminder was already sent today\n  if (\n    previousDate === todayStr &&\n    previousType === reminderType\n  ) continue;\n\n  const message = `${timingMessage}\n\n🔹 Bill: ${bill.BillName}\n💰 Amount: ₹${bill.Amount}\n📅 Due Date: ${dueDate}\n📂 Category: ${bill.Category}\n\nPlease complete your payment on time.\n\n🆔 Bill ID: ${bill.BillID}`;\n\n  alerts.push({\n    json: {\n      ...bill,\n\n      // Telegram fields\n      chatId: String(bill.ChatID),\n      message,\n\n      // Reminder calculation\n      DaysRemaining: daysRemaining,\n      ReminderType: reminderType,\n\n      // IMPORTANT: fields for Google Sheets Update Row\n      LastReminderDate: todayStr,\n      LastReminderType: reminderType\n    }\n  });\n}\n\nreturn alerts;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
