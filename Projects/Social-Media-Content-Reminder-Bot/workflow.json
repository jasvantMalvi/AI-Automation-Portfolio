      "id": "d6e8328e-4cad-428f-a69b-a1d68b6168bc",
      "name": "02 - Fetch Pending Tasks",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -144,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst output = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  // Get ID safely — handles \"ID\" and \"ID \" column names\n  const id = data['ID'] ?? data['ID '] ?? '';\n\n  const rowNumber = data.row_number;\n  const name = data.Name;\n  const platform = data.Platform;\n  const pendingWork = data['Pending Work'];\n  const scheduledTime = data['Scheduled Time'];\n  const status = String(data.Status || '').trim().toLowerCase();\n\n  const reminderCount =\n    parseInt(data['Reminder Count'], 10) || 0;\n\n  // Only process Pending rows\n  if (status !== 'pending') {\n    continue;\n  }\n\n  // Make sure Scheduled Time exists\n  if (!scheduledTime) {\n    continue;\n  }\n\n  // Convert \"2026-08-21 09:30\" to India timezone\n  const scheduledDate = new Date(\n    scheduledTime.replace(' ', 'T') + ':00+05:30'\n  );\n\n  // Skip invalid dates\n  if (isNaN(scheduledDate.getTime())) {\n    continue;\n  }\n\n  // Scheduled time has not arrived yet\n  if (scheduledDate > now) {\n    continue;\n  }\n\n  // Calculate how long the content has been pending\n  const minutesPending = Math.floor(\n    (now - scheduledDate) / 60000\n  );\n\n  // First reminder immediately after scheduled time\n  // Then every 30 minutes\n  const expectedReminderCount =\n    Math.floor(minutesPending / 30) + 1;\n\n  // Already sent the reminder for this period\n  if (reminderCount >= expectedReminderCount) {\n    continue;\n  }\n\n  const nextReminderCount = reminderCount + 1;\n\n  const reminderMessage =\n    `🔔 Content Reminder\\n\\n` +\n    `Hi ${name}, your ${platform} content is still pending.\\n\\n` +\n    `📌 Content: ${pendingWork}\\n` +\n    `⏰ Scheduled: ${scheduledTime}\\n` +\n    `⏳ Pending for: ${minutesPending} minutes\\n` +\n    `🔁 Reminder #${nextReminderCount}\\n\\n` +\n    `Please post it when ready.\\n\\n` +\n    `This message was sent automatically with n8n`;\n\n  output.push({\n    json: {\n      ID: id,\n      rowNumber: rowNumber,\n      Name: name,\n      Platform: platform,\n      'Pending Work': pendingWork,\n      'Scheduled Time': scheduledTime,\n      Status: 'Pending',\n      'Reminder Count': reminderCount,\n      nextReminderCount: nextReminderCount,\n      minutesPending: minutesPending,\n      reminderMessage: reminderMessage,\n      checkedAt: now.toISOString()\n    }\n  });\n}\n\nreturn output;"
      },
