      "parameters": {
        "operation": "send",
        "phoneNumberId": "REPLACE_WITH_YOUR_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('Edit Fields').item.json.userPhonenumber }}",
        "textBody": "=👋 Welcome, {{ $('Edit Fields').item.json.userName }}\n\nThanks for reaching out. We'd be happy to help you choose the right course.\n\n📚 Our Courses:\n\n1️⃣ AI Automation & AI Agents\n2️⃣ Machine Learning\n3️⃣ Data Science\n4️⃣ Python Programming\n5️⃣ Web Development\n6️⃣ Digital Marketing\n\n👉 Reply with the course name or number you're interested in, and we'll share the details.",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        1232,
        208
      ],
      "id": "c38e1e0a-d914-491e-9a01-8599d2d17ba6",
      "name": "Send message"
    },
    {
      "parameters": {
        "jsCode": "// Original WhatsApp data\nconst editData = $('Edit Fields').first().json;\n\n// Existing Google Sheets row\nconst sheetData = $input.first()?.json || {};\n\n// Incoming message\nconst userName = editData.userName || '';\nconst phone = editData.userPhonenumber || '';\nconst message = editData.userMessageOriginal || '';\nconst cleanMessage = editData.userMessage || '';\n\n// Check whether this lead already exists\nconst existingPhone = String(sheetData.phone || '').trim();\n\nconst isExistingLead =\n  existingPhone !== '' &&\n  existingPhone === String(phone).trim();\n\n// Previous follow-up count\nconst previousCount = parseInt(\n  sheetData.follow_up_count || 0,\n  10\n);\n\n// Increase count\nconst followUpCount = previousCount + 1;\n\n// WhatsApp message ID\nconst triggerData = $('WhatsApp Trigger').first().json;\nconst whatsappMessage = triggerData.messages?.[0];\n\nconst messageId = whatsappMessage?.id || '';\n\n// WhatsApp timestamp\nconst timestamp = whatsappMessage?.timestamp\n  ? Number(whatsappMessage.timestamp) * 1000\n  : Date.now();\n\n// India date/time\nconst lastFollowUp = new Date(timestamp).toLocaleString('en-IN', {\n  timeZone: 'Asia/Kolkata',\n  day: '2-digit',\n  month: '2-digit',\n  year: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit',\n  hour12: true\n});\n\n// Tomorrow's date\nconst indiaNow = new Date(\n  new Date().toLocaleString('en-US', {\n    timeZone: 'Asia/Kolkata'\n  })\n);\n\nindiaNow.setDate(indiaNow.getDate() + 1);\n\nconst nextFollowUp = indiaNow.toLocaleDateString('en-IN', {\n  day: '2-digit',\n  month: '2-digit',\n  year: 'numeric'\n});\n\n// Detect greeting\nconst greetings = [\n  'hi',\n  'hello',\n  'hey',\n  'hii',\n  'hola',\n  'good morning',\n  'good afternoon',\n  'good evening'\n];\n\nconst isGreeting = greetings.includes(cleanMessage);\n\n// Detect course\nlet interestedCourse = sheetData.interested_course || '';\n\nif (\n  cleanMessage.includes('ai automation') ||\n  cleanMessage.includes('ai agent') ||\n  cleanMessage === '1'\n) {\n  interestedCourse = 'AI Automation & AI Agents';\n}\n\nelse if (\n  cleanMessage.includes('machine learning') ||\n  cleanMessage === '2'\n) {\n  interestedCourse = 'Machine Learning';\n}\n\nelse if (\n  cleanMessage.includes('data science') ||\n  cleanMessage === '3'\n) {\n  interestedCourse = 'Data Science';\n}\n\nelse if (\n  cleanMessage.includes('python') ||\n  cleanMessage === '4'\n) {\n  interestedCourse = 'Python Programming';\n}\n\nelse if (\n  cleanMessage.includes('web development') ||\n  cleanMessage === '5'\n) {\n  interestedCourse = 'Web Development';\n}\n\nelse if (\n  cleanMessage.includes('digital marketing') ||\n  cleanMessage === '6'\n) {\n  interestedCourse = 'Digital Marketing';\n}\n\n// Lead status\nlet leadStatus;\nlet followUpStatus;\n\nif (!isExistingLead) {\n  leadStatus = 'New';\n  followUpStatus = 'Pending';\n}\nelse if (interestedCourse) {\n  leadStatus = 'Active';\n  followUpStatus = 'Pending';\n}\nelse {\n  leadStatus = sheetData.lead_status || 'Active';\n  followUpStatus = 'Pending';\n}\n\n// Return data matching your Google Sheet\nreturn [\n  {\n    json: {\n      lead_name: userName || sheetData.lead_name || '',\n      phone: phone,\n      message_id: messageId,\n      lead_source: 'WhatsApp',\n\n      lead_status: leadStatus,\n\n      interested_course: interestedCourse,\n\n      follow_up_status: followUpStatus,\n\n      last_follow_up: lastFollowUp,\n\n      next_follow_up: nextFollowUp,\n\n      follow_up_count: followUpCount,\n\n      // Internal fields for workflow logic\n      is_existing_lead: isExistingLead,\n      is_greeting: isGreeting,\n      clean_message: cleanMessage,\n      original_message: message\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
